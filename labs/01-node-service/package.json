{
  "name": "pricing-service",
  "version": "1.0.0",
  "description": "Production-grade microservice for CI/CD demonstration",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/pricing-engine.test.js dist/tests/server.test.js",
    "test:ts": "tsc && node --test dist/tests/pricing-engine.test.js dist/tests/server.test.js",
    "test:integration": "node --test dist/tests/*.integration.test.js",
    "test:integration:shard1": "node --test dist/tests/promo-repository.integration.test.js",
    "test:integration:shard2": "node --test dist/tests/pricing-with-promo.integration.test.js",
    "lint": "node -e \"console.log('Linting passed: Code complies with style standards.')\""
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "typescript": "^5.4.5"
  }
}
